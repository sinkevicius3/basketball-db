#include <stdio.h>
#include <stdbool.h> 
#include <string.h>
#include <stdlib.h>

#define MENU_OPTIONS 6
#define SQLCODE sqlca.sqlcode

void connect_db();
void disconnect_db();

void printMenuOptions();

int getInput(const char *msg, char *buffer, int size);
void flushInput();

void addPlayer();
void showPlayerExtendedInfo();
void updatePlayer();
void deletePlayer();
void tradePlayers();

EXEC SQL INCLUDE sqlca.h;

EXEC SQL BEGIN DECLARE SECTION;
  const char *dbname = "basketball";
EXEC SQL END DECLARE SECTION;

void connect_db() {
  EXEC SQL CONNECT TO :dbname;

  if (SQLCODE != 0) {
    printf("Connection failed: %s\n", sqlca.sqlerrm.sqlerrmc);
    exit(1);
  }

  printf("Connected to database '%s'.\n", dbname);
}

void disconnect_db() {
  EXEC SQL DISCONNECT ALL;
}

void printMenuOptions() {
  printf("\n=== Basketball DB ===\n");
  printf("1) Add player.\n");
  printf("2) Show players.\n");
  printf("3) Update player.\n");
  printf("4) Delete player.\n");
  printf("5) Trade players.\n");
  printf("0) Exit.\n\n");
}

int getInput(const char *msg, char *buffer, int size) {
  printf("%s", msg);
  fgets(buffer, size, stdin);
  if (buffer[strcspn(buffer, "\n")] == '\n') {
    buffer[strcspn(buffer, "\n")] = '\0';
  } else {
    flushInput();
  }
  return buffer[0] != '\0';
}

void flushInput() {
  int c;
  while ((c = getchar()) != '\n' && c != EOF);
}

void addPlayer() {
  EXEC SQL BEGIN DECLARE SECTION;
    char first_name[51];
    char last_name[51];
    char birth_date[11];
    char nationality[4];
    char position[2];
    int team_id;
    char start_date[11];
    char end_date[11];
    double value;
    int position_ind;
    int team_id_ind;
    int start_date_ind;
    int end_date_ind;
    int value_ind;
  EXEC SQL END DECLARE SECTION;

  char position_buf[2];
  char team_buf[12];
  char value_buf[20];

  EXEC SQL WHENEVER SQLERROR GOTO error;
  EXEC SQL WHENEVER NOT FOUND DO BREAK;

  getInput("Enter first name: ", first_name, sizeof(first_name));
  getInput("Enter last name: ", last_name, sizeof(last_name));
  getInput("Enter birth date (YYYY-MM-DD): ", birth_date, sizeof(birth_date));
  getInput("Enter nationality ('LTU', 'USA', ...): ", nationality, sizeof(nationality));

  if(getInput("Enter position ('G', 'F', 'C', or press Enter to skip): ", position_buf, sizeof(position_buf))) {
    strcpy(position, position_buf);
    position_ind = 0;
  } else {
    position_ind = -1;
  }

  printf("\n=== Available Teams ===\n");
  EXEC SQL DECLARE team_cursor CURSOR FOR
    SELECT id, name, city FROM team;
  EXEC SQL OPEN team_cursor;

  EXEC SQL BEGIN DECLARE SECTION;
    int t_id;
    char t_name[51];
    char t_city[51];
  EXEC SQL END DECLARE SECTION;

  while (1) {
    EXEC SQL FETCH team_cursor INTO :t_id, :t_name, :t_city;
    printf("%d) %s %s\n", t_id, t_city, t_name);
  }
  EXEC SQL CLOSE team_cursor;

  EXEC SQL WHENEVER NOT FOUND CONTINUE;

  if (getInput("\nEnter team ID (or press Enter to skip): ", team_buf, sizeof(team_buf))) {
    team_id = atoi(team_buf);
    team_id_ind = 0;

    getInput("Enter start date (YYYY-MM-DD): ", start_date, sizeof(start_date));
    getInput("Enter end date (YYYY-MM-DD): ", end_date, sizeof(end_date));
    getInput("Enter value: ", value_buf, sizeof(value_buf));

    value = atof(value_buf);
    start_date_ind = 0;
    end_date_ind = 0;
    value_ind = 0;
  } else {
    team_id_ind = -1;
    start_date_ind = -1;
    end_date_ind = -1;
    value_ind = -1;
  }

  EXEC SQL INSERT INTO player (first_name, last_name, birth_date, nationality, position, team, start_date, end_date, value)
  VALUES (:first_name, :last_name, :birth_date, :nationality, :position INDICATOR :position_ind,
    :team_id INDICATOR :team_id_ind, :start_date INDICATOR :start_date_ind,
    :end_date INDICATOR :end_date_ind, :value INDICATOR :value_ind);

  EXEC SQL COMMIT;
  printf("Player added successfully!\n");

  EXEC SQL WHENEVER SQLERROR CONTINUE;
  EXEC SQL WHENEVER NOT FOUND CONTINUE;
  return;

  error:
    printf("Error adding player: %s\n", sqlca.sqlerrm.sqlerrmc);
    EXEC SQL ROLLBACK;
    EXEC SQL WHENEVER SQLERROR CONTINUE;
    EXEC SQL WHENEVER NOT FOUND CONTINUE;
}

void showPlayerExtendedInfo() {
  EXEC SQL BEGIN DECLARE SECTION;
    int id;
    char first_name[51];
    char last_name[51];
    char birth_date[11];
    char nationality[4];
    char position[2];
    int team;
    char start_date[11];
    char end_date[11];
    double value;
    int age;
    int contract_days_left;
    int team_ind;
    int position_ind;
    int start_date_ind;
    int end_date_ind;
    int value_ind;
    int contract_days_left_ind;
  EXEC SQL END DECLARE SECTION;

  EXEC SQL WHENEVER SQLERROR GOTO error;
  EXEC SQL WHENEVER NOT FOUND DO BREAK;

  printf("\n=== Players ===\n");

  EXEC SQL DECLARE player_cursor CURSOR FOR
    SELECT id, first_name, last_name, birth_date, nationality, position, team,
      start_date, end_date, value, age, contract_days_left
    FROM player_extended_info;

  EXEC SQL OPEN player_cursor;

  printf("|| %-4s || %-20s || %-20s || %-10s || %-3s || %-4s || %-4s || %-10s || %-10s || %-12s || %-4s || %-10s ||\n",
    "ID", "First name", "Last name", "Birth date", "Nat", "Pos", "Team",
    "Start date", "End date", "Value", "Age", "Days left");

  while (1) {
    EXEC SQL FETCH player_cursor INTO
      :id, :first_name, :last_name, :birth_date, :nationality,
      :position INDICATOR :position_ind,
      :team INDICATOR :team_ind,
      :start_date INDICATOR :start_date_ind,
      :end_date INDICATOR :end_date_ind,
      :value INDICATOR :value_ind,
      :age,
      :contract_days_left INDICATOR :contract_days_left_ind;

    printf("|| %-4d || %-20s || %-20s || %-10s || %-3s || %-4s || %-4d || %-10s || %-10s || %-12.2f || %-4d || %-10d ||\n",
      id, first_name, last_name, birth_date, nationality,
      position_ind == -1 ? "N/A" : position,
      team_ind == -1 ? 0 : team,
      start_date_ind == -1 ? "N/A" : start_date,
      end_date_ind == -1 ? "N/A" : end_date,
      value_ind == -1 ? 0.0 : value,
      age,
      contract_days_left_ind == -1 ? 0 : contract_days_left);
  }

  EXEC SQL CLOSE player_cursor;
  EXEC SQL WHENEVER SQLERROR CONTINUE;
  EXEC SQL WHENEVER NOT FOUND CONTINUE;
  return;

  error:
    printf("Database error: %s\n", sqlca.sqlerrm.sqlerrmc);
    EXEC SQL CLOSE player_cursor;
    EXEC SQL WHENEVER SQLERROR CONTINUE;
    EXEC SQL WHENEVER NOT FOUND CONTINUE;
}

void updatePlayer() {
  EXEC SQL BEGIN DECLARE SECTION;
    int target_id;
    char first_name[51];
    char last_name[51];
    char birth_date[11];
    char nationality[4];
    char position[2];
    int team_id;
    char start_date[11];
    char end_date[11];
    double value;
    int position_ind;
    int team_id_ind;
    int start_date_ind;
    int end_date_ind;
    int value_ind;
    int t_id;
    char t_name[51];
    char t_city[51];
  EXEC SQL END DECLARE SECTION;

  char buf[51];
  char id_buf[12];

  showPlayerExtendedInfo();

  if (getInput("\nEnter player ID to update (or press Enter to cancel): ", id_buf, sizeof(id_buf)) == 0) {
    return;
  }

  target_id = atoi(id_buf); // ascii to integer

  EXEC SQL WHENEVER SQLERROR GOTO error;
  EXEC SQL WHENEVER NOT FOUND GOTO not_found;

  EXEC SQL SELECT first_name, last_name, birth_date, nationality, position, team, start_date, end_date, value
    INTO :first_name, :last_name, :birth_date, :nationality,
      :position INDICATOR :position_ind,
      :team_id INDICATOR :team_id_ind,
      :start_date INDICATOR :start_date_ind,
      :end_date INDICATOR :end_date_ind,
      :value INDICATOR :value_ind
    FROM player
    WHERE id = :target_id;

  printf("\n|| %-4s || %-20s || %-20s || %-10s || %-3s || %-4s || %-4s || %-10s || %-10s || %-12s ||\n",
  "ID", "First name", "Last name", "Birth date", "Nat", "Pos", "Team",
  "Start date", "End date", "Value");

  printf("|| %-4d || %-20s || %-20s || %-10s || %-3s || %-4s || %-4d || %-10s || %-10s || %-12.2f ||\n",
  target_id, first_name, last_name, birth_date, nationality,
  position_ind == -1 ? "N/A" : position,
  team_id_ind == -1 ? 0 : team_id,
  start_date_ind == -1 ? "N/A" : start_date,
  end_date_ind == -1 ? "N/A" : end_date,
  value_ind == -1 ? 0.0 : value);

  printf("\n(Enter new value or press 'Enter' to keep current value, type 'null' to clear nullable fields)\n\n");

  EXEC SQL WHENEVER NOT FOUND CONTINUE;

  if (getInput("Enter first name: ", buf, sizeof(buf))){
    strncpy(first_name, buf, sizeof(first_name));
  }

  if (getInput("Enter last name: ", buf, sizeof(buf))){
    strncpy(last_name, buf, sizeof(last_name));
  }

  if (getInput("Enter birth date (YYYY-MM-DD): ", buf, sizeof(buf))){
    strncpy(birth_date, buf, sizeof(birth_date));
  }

  if (getInput("Enter nationality ('LTU', 'USA', ...): ", buf, sizeof(buf))){
    strncpy(nationality, buf, sizeof(nationality));
  }

  if (getInput("Enter position ('G', 'F', 'C', or type 'null' to clear): ", buf, sizeof(buf))) {
    if (strcmp(buf, "null") == 0) {
      position_ind = -1;
    } else {
      strncpy(position, buf, sizeof(position));
      position_ind = 0;
    }
  }

  printf("\n=== Available Teams ===\n");
  EXEC SQL DECLARE update_team_cursor CURSOR FOR
    SELECT id, name, city FROM team;
  EXEC SQL OPEN update_team_cursor;

  EXEC SQL WHENEVER NOT FOUND DO BREAK;

  while (1) {
    EXEC SQL FETCH update_team_cursor INTO :t_id, :t_name, :t_city;
    printf("%d) %s %s\n", t_id, t_city, t_name);
  }

  EXEC SQL CLOSE update_team_cursor;
  EXEC SQL WHENEVER NOT FOUND CONTINUE;

  if (getInput("\nEnter team ID or type 'null' to clear: ", buf, sizeof(buf))) {
    if (strcmp(buf, "null") == 0) {
      team_id_ind = -1;
      start_date_ind = -1;
      end_date_ind = -1;
      value_ind = -1;
    } else {
      team_id = atoi(buf);
      team_id_ind = 0;

      if (getInput("Enter start date (YYYY-MM-DD): ", buf, sizeof(buf))) {
        strncpy(start_date, buf, sizeof(start_date));
        start_date_ind = 0;
      }

      if (getInput("Enter end date (YYYY-MM-DD): ", buf, sizeof(buf))) {
        strncpy(end_date, buf, sizeof(end_date));
        end_date_ind = 0;
      }

      if (getInput("Enter value: ", buf, sizeof(buf))) {
        if (strcmp(buf, "null") == 0) {
          value_ind = -1;
        } else {
          value = atof(buf);
          value_ind = 0;
        }
      }
    }
  } else {
    if (team_id_ind != -1) {
      if (getInput("Enter start date (YYYY-MM-DD): ", buf, sizeof(buf))) {
        strncpy(start_date, buf, sizeof(start_date));
        start_date_ind = 0;
      }

      if (getInput("Enter end date (YYYY-MM-DD): ", buf, sizeof(buf))) {
        strncpy(end_date, buf, sizeof(end_date));
        end_date_ind = 0;
      }

      if (getInput("Enter value: ", buf, sizeof(buf))) {
        if (strcmp(buf, "null") == 0) {
          value_ind = -1;
        } else {
          value = atof(buf);
          value_ind = 0;
        }
      }
    }
  }

  EXEC SQL UPDATE player
    SET first_name = :first_name,
      last_name = :last_name,
      birth_date = :birth_date,
      nationality = :nationality,
      position = :position INDICATOR :position_ind,
      team = :team_id INDICATOR :team_id_ind,
      start_date = :start_date INDICATOR :start_date_ind,
      end_date = :end_date INDICATOR :end_date_ind,
      value = :value INDICATOR :value_ind
    WHERE id = :target_id;

  EXEC SQL COMMIT;
  printf("Player updated successfully!\n");

  EXEC SQL WHENEVER SQLERROR CONTINUE;
  EXEC SQL WHENEVER NOT FOUND CONTINUE;
  return;

  not_found:
    printf("Player with ID %d not found.\n", target_id);
    EXEC SQL WHENEVER SQLERROR CONTINUE;
    EXEC SQL WHENEVER NOT FOUND CONTINUE;
    return;

  error:
    printf("Error updating player: %s\n", sqlca.sqlerrm.sqlerrmc);
    EXEC SQL ROLLBACK;
    EXEC SQL WHENEVER SQLERROR CONTINUE;
    EXEC SQL WHENEVER NOT FOUND CONTINUE;
}

void deletePlayer() {
  EXEC SQL BEGIN DECLARE SECTION;
    int target_id;
  EXEC SQL END DECLARE SECTION;

  char id_buf[12];
  char confirm_buf[4];

  showPlayerExtendedInfo();

  if (getInput("\nEnter player ID to delete (or press Enter to cancel): ", id_buf, sizeof(id_buf)) == 0){
    return;
  }

  target_id = atoi(id_buf);

  char confirm_prompt[80];
  snprintf(confirm_prompt, sizeof(confirm_prompt), "Are you sure you want to delete player (id = %d)? (yes/no): ", target_id);
  if (getInput(confirm_prompt, confirm_buf, sizeof(confirm_buf)) == 0) {
    return;
  }

  if (strcmp(confirm_buf, "yes") != 0) {
    return;
  }

  EXEC SQL WHENEVER SQLERROR GOTO error;
  EXEC SQL WHENEVER NOT FOUND GOTO not_found;

  EXEC SQL DELETE FROM player WHERE id = :target_id;

  EXEC SQL COMMIT;

  printf("Player deleted successfully!\n");

  EXEC SQL WHENEVER SQLERROR CONTINUE;
  EXEC SQL WHENEVER NOT FOUND CONTINUE;

  return;

  not_found:
    printf("Player with ID %d not found.\n", target_id);
    EXEC SQL WHENEVER SQLERROR CONTINUE;
    EXEC SQL WHENEVER NOT FOUND CONTINUE;
    return;

  error:
    printf("Error deleting player: %s\n", sqlca.sqlerrm.sqlerrmc);
    EXEC SQL ROLLBACK;
    EXEC SQL WHENEVER SQLERROR CONTINUE;
    EXEC SQL WHENEVER NOT FOUND CONTINUE;
}

void tradePlayers() {
  EXEC SQL BEGIN DECLARE SECTION;
    int player1_id;
    int player2_id;
    int player1_team;
    int player2_team;
    char player1_name[102];
    char player2_name[102];
    int p1_team_ind;
    int p2_team_ind;
  EXEC SQL END DECLARE SECTION;

  char id_buf[12];
  char confirm_buf[4];

  showPlayerExtendedInfo();

  EXEC SQL WHENEVER SQLERROR GOTO error;
  EXEC SQL WHENEVER NOT FOUND GOTO not_found;

  if (getInput("\nEnter first player ID (or press Enter to cancel): ", id_buf, sizeof(id_buf)) == 0) {
    return;
  }
  player1_id = atoi(id_buf);

  EXEC SQL SELECT team, first_name || ' ' || last_name
    INTO :player1_team INDICATOR :p1_team_ind, :player1_name
    FROM player
    WHERE id = :player1_id;

  if (getInput("Enter second player ID (or press Enter to cancel): ", id_buf, sizeof(id_buf)) == 0) {
    return;
  }
  player2_id = atoi(id_buf);

  EXEC SQL SELECT team, first_name || ' ' || last_name
    INTO :player2_team INDICATOR :p2_team_ind, :player2_name
    FROM player
    WHERE id = :player2_id;

  if (p1_team_ind == -1 || p2_team_ind == -1 || player1_team == player2_team || player1_id == player2_id) {
    printf("Invalid trade: players must be on different teams and both must have a team.\n");
    return;
  }

  printf("\nTrade details:\n");
  printf("%s (team id = %d) <-> %s (team id = %d)\n", player1_name, player1_team, player2_name, player2_team);

  if (getInput("Confirm trade? (yes/no): ", confirm_buf, sizeof(confirm_buf)) == 0) {
    return;
  }

  if (strcmp(confirm_buf, "yes") != 0) {
    printf("Trade cancelled.\n");
    return;
  }

  EXEC SQL UPDATE player
    SET team = :player2_team
    WHERE id = :player1_id;

  EXEC SQL UPDATE player
    SET team = :player1_team
    WHERE id = :player2_id;

  EXEC SQL COMMIT;
  printf("Trade completed successfully!\n");

  EXEC SQL WHENEVER SQLERROR CONTINUE;
  EXEC SQL WHENEVER NOT FOUND CONTINUE;
  return;

  not_found:
    printf("Player not found.\n");
    EXEC SQL WHENEVER SQLERROR CONTINUE;
    EXEC SQL WHENEVER NOT FOUND CONTINUE;
    return;

  error:
    printf("Error trading players: %s\n", sqlca.sqlerrm.sqlerrmc);
    EXEC SQL ROLLBACK;
    EXEC SQL WHENEVER SQLERROR CONTINUE;
    EXEC SQL WHENEVER NOT FOUND CONTINUE;
}

int main(int argc, char **argv) { 
  int option;
  char c;

  connect_db();

  while (1) {
    printMenuOptions();
    printf("Enter the option's number: ");
    if (scanf("%d%c", &option, &c) != 2 || c != '\n') {
      printf("Incorrect input, please enter an integer.\n");
      flushInput();
      continue;
    }

    switch (option) {
      case 1:
        addPlayer();
        break;
      case 2:
        showPlayerExtendedInfo();
        break;
      case 3:
        updatePlayer();
        break;
      case 4:
        deletePlayer();
        break;
      case 5:
        tradePlayers();
        break;
      case 0:
        disconnect_db();
        printf("Shutting down...\n");
        exit(0);
      default:
        printf("Option does not exist.\n");
        break;
    }
  }

  return 0;
}